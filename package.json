{
  "name": "decisionator",
  "version": "0.2.0",
  "description": "A local human-in-the-loop interface for batched decisions between an AI coding agent and a human.",
  "private": true,
  "license": "MIT",
  "author": "Jan Romaniak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johniak/decisionator.git"
  },
  "homepage": "https://github.com/johniak/decisionator#readme",
  "bugs": {
    "url": "https://github.com/johniak/decisionator/issues"
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "decisions",
    "human-in-the-loop",
    "mockups"
  ],
  "packageManager": "bun@1.3.13",
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun src/cli.ts",
    "demo": "bun run build:web && bun scripts/demo.ts --live",
    "build": "bun run build:web && bun run build:cli",
    "build:web": "vite build && bun scripts/prepare-web.ts",
    "build:cli": "bun build --compile --minify --target=bun src/cli.ts --outfile dist/decisionator",
    "typecheck": "tsc --noEmit",
    "test": "bun run build:web && vitest run",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.53.0",
    "mermaid": "^12.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "jsdom": "26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
